/*
 * Lily58 "双核驱动" 过渡版 (冗余常规键 + Callum OSM)
 * 进化路线：Lily58 (58键) → Silakka54 方式使用 → Corne (36键)
 *
 * 核心特色：
 * 1. 外围保留全套标准键位（防忘、方便单手操作、打游戏）
 * 2. 核心区保留 Callum-style OSM 与 Vim 导航（追求极致编码效率）
 * 3. 严格遵循 3 拇指原则，全键盘仅 4 个键置空
 *
 * Layer 0: Base    - QWERTY + 外围冗余（物理 Shift/Ctrl/数字行）
 * Layer 1: Nav     - 左手 OSM 修饰键 + 右手 Vim HJKL + 翻页
 * Layer 2: Sym     - 左手九宫格数字 + 右手程序员符号
 * Layer 3: System  - F 键（与九宫格对齐）+ 蓝牙 + 音量 + Bootloader
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define SYS  3

/ {
    behaviors {
        // Callum-style 快速释放 OSM（解决连续打字修饰键粘连）
        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK_RELEASE";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        // 拇指层键：按住维持层，轻点 One-Shot 层
        mo_sl: behavior_mo_sl {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_SL";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo &sl>;
        };
    };

    combos {
        compatible = "zmk,combos";
        // Vim 神器：J + K = Escape（退出 Insert 模式）
        combo_esc {
            timeout-ms = <50>;
            key-positions = <31 32>;  // J 和 K 在 Lily58 矩阵中的位置
            bindings = <&kp ESC>;
            layers = <BASE>;
        };

        // F + J = Caps Word（双食指归位键，输入蛇形命名超方便）
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <28 31>;  // F 和 J
            bindings = <&caps_word>;
            layers = <BASE>;
        };

        // M + , = 音量↓
        combo_vol_dn {
            timeout-ms = <50>;
            key-positions = <45 46>;  // M 和 ,
            bindings = <&kp C_VOL_DN>;
        };

        // , + . = 音量↑
        combo_vol_up {
            timeout-ms = <50>;
            key-positions = <46 47>;  // , 和 .
            bindings = <&kp C_VOL_UP>;
        };
    };

    // Conditional Layer: NAV + SYM 同时激活 → SYS
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | CTRL  |  Z  |  X  |  C   |  V   |  B   | (none) |  |(none) |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     |  ALT |  NAV | SPACE| (none) |  |(none) | ENTER|  SYM  | BSPC  |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4  &kp N5                     &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp GRAVE
&kp TAB   &kp Q  &kp W  &kp E    &kp R   &kp T                      &kp Y  &kp U    &kp I     &kp O   &kp P    &kp MINUS
&kp LSHFT &kp A  &kp S  &kp D    &kp F   &kp G                      &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL &kp Z  &kp X  &kp C    &kp V   &kp B  &none      &none    &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LALT &mo_sl NAV NAV &kp SPACE &none     &none    &kp RET &mo_sl SYM SYM &kp BSPC
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            display-name = "Nav";
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       | ESC |S-TAB| RET  | GUI  | BSPC |                   |C(←)  | END   | HOME  | C(→) |  DEL  |       |
// |       | TAB | ALT | CTRL |SHIFT |CAPW  |                   |  ←   |   ↓   |   ↑   |  →   | PGUP  |       |
// |       |C(Z) |C(X) | C(C) | C(V) |      | (none) |  |(none) |C(BSP)|C(DEL) | C(U)  | C(D) | PGDN   |       |
//                     |      | ▓▓▓▓ |      | (none) |  |(none) |      |       |       |
            bindings = <
&trans &trans     &trans       &trans     &trans     &trans                   &trans       &trans    &trans   &trans    &trans        &trans
&trans &kp ESC   &kp LS(TAB)  &kp RET    &skq LGUI  &kp BSPC                 &kp LC(LEFT) &kp END   &kp HOME  &kp LC(RIGHT) &kp DEL   &trans
&trans &kp TAB   &skq LALT    &skq LCTRL &skq LSHFT &caps_word               &kp LEFT     &kp DOWN  &kp UP    &kp RIGHT     &kp PG_UP &trans
&trans &kp LC(Z) &kp LC(X)    &kp LC(C)  &kp LC(V)  &trans &none    &none    &kp LC(BSPC) &kp LC(DEL) &kp LC(U) &kp LC(D)     &kp PG_DN &trans
                              &trans     &trans     &trans &none    &none    &trans       &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            display-name = "Sym";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |     |  7  |  8   |  9   |  -   |                   |  !   |  (    |  )    |  _   |   :   |       |
// |       |     |  4  |  5   |  6   |  +   |                   |  ~   |  {    |  }    |  |   |   "   |       |
// |       |  .  |  1  |  2   |  3   |  =   | (none) |  |(none) |  `   |  [    |  ]    |  \   |   ?   |       |
//                     |  0   |      |      | (none) |  |(none) |      | ▓▓▓▓  |       |
            bindings = <
&trans &trans    &trans &trans &trans &trans                    &trans     &trans   &trans   &trans    &trans     &trans
&trans &trans    &kp N7 &kp N8 &kp N9 &kp MINUS               &kp EXCL   &kp LPAR &kp RPAR &kp UNDER &kp COLON  &trans
&trans &trans    &kp N4 &kp N5 &kp N6 &kp PLUS                &kp TILDE  &kp LBRC &kp RBRC &kp PIPE  &kp DQT    &trans
&trans &kp DOT  &kp N1 &kp N2 &kp N3 &kp EQUAL &none  &none   &kp GRAVE  &kp LBKT &kp RBKT &kp BSLH  &kp QMARK  &trans
                       &kp N0 &trans &trans    &none   &none   &trans     &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sys_layer {
            display-name = "System";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |     |  F7 |  F8  |  F9  | F12  |                   | BT0  | BT1   | BT2   |BTCLR | BOOT  |       |
// |       |     |  F4 |  F5  |  F6  | F11  |                   | MUTE | VOL-  | VOL+  | BRI- | BRI+  |       |
// |       |     |  F1 |  F2  |  F3  | F10  | (none) |  |(none) |      | PREV  | PLAY  | NEXT |       |       |
//                     |      | ▓▓▓▓ |      | (none) |  |(none) |      | ▓▓▓▓  |       |
            bindings = <
&trans &trans  &trans &trans &trans &trans                   &trans         &trans         &trans         &trans       &trans       &trans
&trans &trans  &kp F7 &kp F8 &kp F9 &kp F12                  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_CLR   &bootloader  &trans
&trans &trans  &kp F4 &kp F5 &kp F6 &kp F11                  &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP   &kp C_BRI_DN &kp C_BRI_UP &trans
&trans &trans  &kp F1 &kp F2 &kp F3 &kp F10 &none    &none   &trans         &kp C_PREV     &kp C_PP       &kp C_NEXT   &trans       &trans
                             &trans &trans  &trans   &none    &none   &trans         &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
