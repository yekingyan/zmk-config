/*
 * Lily58 Callum-style OSM Keymap
 * 设计：QWERTY 基础层 + OSM 修饰键 + Vim 导航
 * 进化路线：Lily58 (58键) → Silakka54 方式使用 → Corne (36键)
 *
 * Layer 0: Base    - 纯 QWERTY，字母区零延迟
 * Layer 1: Nav     - 左手 OSM 修饰键 + 右手 Vim HJKL + 翻页
 * Layer 2: Sym     - 左手九宫格数字 + 右手程序员符号
 * Layer 3: System  - F 键 + 蓝牙 + 音量 + Bootloader
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define SYS  3

/ {
    behaviors {
        // Callum-style 快速释放 OSM
        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK_RELEASE";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };
    };

    combos {
        compatible = "zmk,combos";
        // J + K = Escape（Vim 退出 Insert 模式）
        combo_esc {
            timeout-ms = <50>;
            key-positions = <31 32>;  // J 和 K 在 Lily58 矩阵中的位置
            bindings = <&kp ESC>;
            layers = <BASE>;
        };
    };

    // Conditional Layer: NAV + SYM 同时激活 → SYS
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BSPC  |
// |  ESC  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | ALT  | GUI  | NAV  |  SPACE |  | ENTER | SYM  | BSPC  | GUI   |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                     &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp GRAVE
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                      &kp Y  &kp U    &kp I     &kp O   &kp P    &kp BSPC
&kp ESC   &kp A  &kp S  &kp D    &kp F    &kp G                      &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &kp LBKT   &kp RBKT &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LALT &kp LGUI &mo NAV &kp SPACE  &kp RET  &mo SYM &kp BSPC &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            display-name = "Nav";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |     |     |      |      |      |                   | C(D) | C(U)  |       |      |       |  DEL  |
// |       | GUI | ALT | CTRL |SHIFT |      |                   |  ←   |   ↓   |   ↑   |  →   |       |       |
// |       |     |     |      |      |      |        |  |       | HOME | PGDN  | PGUP  | END  |       |       |
//                     |      |      | ▓▓▓▓ |        |  |       | SYS  |       |       |
            bindings = <
&trans &trans    &trans    &trans     &trans     &trans                   &trans      &trans     &trans    &trans    &trans &trans
&trans &trans    &trans    &trans     &trans     &trans                   &kp LC(D)   &kp LC(U)  &trans    &trans    &trans &kp DEL
&trans &skq LGUI &skq LALT &skq LCTRL &skq LSHFT &trans                  &kp LEFT    &kp DOWN   &kp UP    &kp RIGHT &trans &trans
&trans &trans    &trans    &trans     &trans     &trans &trans   &trans   &kp HOME    &kp PG_DN  &kp PG_UP &kp END   &trans &trans
                          &trans     &trans     &trans &trans   &trans   &mo SYS     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            display-name = "Sym";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |     |  7  |  8   |  9   |      |                   |  -   |  (    |  )    |  _   |       |       |
// |       |  0  |  4  |  5   |  6   |      |                   |  =   |  {    |  }    |  +   |   |   |       |
// |       |     |  1  |  2   |  3   |      |        |  |       |  `   |  [    |  ]    |  \   |   ~   |       |
//                     |      |      | SYS  |        |  |       | ▓▓▓▓ |       |       |
            bindings = <
&trans &trans &trans &trans &trans &trans                   &trans    &trans   &trans   &trans    &trans    &trans
&trans &trans &kp N7 &kp N8 &kp N9 &trans                   &kp MINUS &kp LPAR &kp RPAR &kp UNDER &trans    &trans
&trans &kp N0 &kp N4 &kp N5 &kp N6 &trans                   &kp EQUAL &kp LBRC &kp RBRC &kp PLUS  &kp PIPE  &trans
&trans &trans &kp N1 &kp N2 &kp N3 &trans &trans   &trans   &kp GRAVE &kp LBKT &kp RBKT &kp BSLH  &kp TILDE &trans
                     &trans &trans &mo SYS &trans   &trans   &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sys_layer {
            display-name = "System";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 | BT3  | BT4  | BT5  |                   |      |       |       |      |       | BOOT  |
// |       | F1  | F2  |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |       |
// | CWRD  | F11 | F12 |      |      |      |                   | MUTE | VOL-  | VOL+  | BRI- | BRI+  |       |
// |       |     |     |      |      |      |        |  |       |      | PREV  | PLAY  | NEXT |       |       |
//                     |      |      | ▓▓▓▓ |        |  |       | ▓▓▓▓ |       |       |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                 &trans     &trans       &trans     &trans       &trans       &bootloader
&trans     &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                       &kp F6     &kp F7       &kp F8     &kp F9       &kp F10      &trans
&caps_word &kp F11      &kp F12      &trans       &trans       &trans                       &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &trans
&trans     &trans       &trans       &trans       &trans       &trans &trans       &trans   &trans     &kp C_PREV   &kp C_PP   &kp C_NEXT   &trans       &trans
                                     &trans       &trans       &trans &trans       &trans   &trans     &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
