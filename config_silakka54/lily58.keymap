/*
 * Silakka54 "双核驱动" 过渡版 (冗余常规键 + Callum OSM)
 * 进化路线：Lily58 (58键) → Corne (36键)
 *
 * 核心特色：
 * 1. 外围保留全套标准键位（物理 Shift/Ctrl/数字行）
 * 2. 核心区保留 Callum-style OSM 与 Vim 导航（追求极致编码效率）
 * 3. 严格遵循 3 拇指原则
 *
 * Layer 0: Base     - QWERTY + 外围冗余（物理 Shift/Ctrl/数字行）
 * Layer 1: Nav      - 左手 OSM 修饰键 + 右手 Vim HJKL + 跳跃 + 翻页
 * Layer 2: Numpad   - 左手算术运算 + 右手纯数字九宫格
 * Layer 3: Symbols  - 左手符号区 + 右手 OSM 修饰键
 * Layer 4: Function - 左手 OSM/BT + 右手 F 键九宫格
 * Layer 5: Mouse    - 左手鼠标移动/滚轮/点击 + 右手 OSM
 * Layer 6: Media    - 左手媒体/音量/亮度 + 右手 OSM
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// 必须在引入 pointing.h 之前定义，以此覆写系统默认的属性
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // 提高基础移动速度 (默认 600)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // 提高滚轮速度 (默认 10)
#include <dt-bindings/zmk/pointing.h>

// Snipe 模式：1/4 速度（精准微操）
#define SNIPE_MOVE_VAL (ZMK_POINTING_DEFAULT_MOVE_VAL / 4)
#define SNIPE_U MOVE_Y(-SNIPE_MOVE_VAL)
#define SNIPE_D MOVE_Y(SNIPE_MOVE_VAL)
#define SNIPE_L MOVE_X(-SNIPE_MOVE_VAL)
#define SNIPE_R MOVE_X(SNIPE_MOVE_VAL)

// Turbo 模式：2x 速度（快速穿梭）
#define TURBO_MOVE_VAL (ZMK_POINTING_DEFAULT_MOVE_VAL * 2)
#define TURBO_U MOVE_Y(-TURBO_MOVE_VAL)
#define TURBO_D MOVE_Y(TURBO_MOVE_VAL)
#define TURBO_L MOVE_X(-TURBO_MOVE_VAL)
#define TURBO_R MOVE_X(TURBO_MOVE_VAL)

#define BASE  0
#define NAV   1
#define NUM   2
#define SYM   3
#define FUN   4
#define MOUSE 5
#define MEDIA 6
#define M_SNIPE 7
#define M_TURBO 8

// 覆写 mmv 和 msc 的默认属性
&mmv {
    acceleration-exponent = <1>;      // 1为线性，2为二次加速
    time-to-max-speed-ms = <500>;     // 达到最大速度的时间
    delay-ms = <0>;
};

&msc {
    acceleration-exponent = <1>;      // 1为线性，2为二次加速
    time-to-max-speed-ms = <500>;     // 达到最大速度的时间
    delay-ms = <0>;
};

// Caps Word：允许连字符不中断大写（支持 MY-CONST 风格命名）
&caps_word {
    continue-list = <UNDERSCORE MINUS>;
};

/ {
    behaviors {
        // Callum-style 快速释放 OSM（解决连续打字修饰键粘连）
        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        // 普通 OSM（用于 Ctrl/Alt/GUI，支持链式组合）
        skn: sticky_key_normal {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            ignore-modifiers;
        };

        // 拇指专用 Layer-Tap（快速打字防误触）
        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        swapper: swapper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_release &kp LALT>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";
        // Vim 神器：J + K = Escape（退出 Insert 模式）
        combo_esc {
            timeout-ms = <50>;
            key-positions = <31 32>;  // J 和 K 在 Lily58 矩阵中的位置
            bindings = <&kp ESC>;
            layers = <BASE>;
            require-prior-idle-ms = <200>;
        };

        // F + J = Caps Word（双食指归位键，输入蛇形命名超方便）
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <28 31>;  // F 和 J
            bindings = <&caps_word>;
            layers = <BASE>;
            require-prior-idle-ms = <200>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// ┌─────┬─────┬─────┬─────┬─────┬─────┐               ┌─────┬─────┬─────┬─────┬─────┬─────┐
// │  `  │  1  │  2  │  3  │  4  │  5  │               │  6  │  7  │  8  │  9  │  0  │  ~  │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │ TAB │  Q  │  W  │  E  │  R  │  T  │               │  Y  │  U  │  I  │  O  │  P  │  -  │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │LSHFT│  A  │  S  │  D  │  F  │  G  │               │  H  │  J  │  K  │  L  │  ;  │  '  │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐   ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │CTRL │ C_Z │  X  │  C  │  V  │  B  │  -  │   │  =  │  N  │  M  │  ,  │  .  │  /  │RSHFT│
// └─────┴─────┴─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────┴─────┘
//                   │ ESC │SPACE│ TAB │  -  │   │  =  │ENTER│BSPC │LSHFT│
//                   │(FUN)│(NAV)│(NUM)│     │   │     │(SYM)│(MOU)│(MED)│
//                   └─────┴─────┴─────┴─────┘   └─────┴─────┴─────┴─────┘
            bindings = <
&kp GRAVE  &kp N1 &kp N2 &kp N3        &kp N4          &kp N5                             &kp N6        &kp N7            &kp N8            &kp N9  &kp N0   &kp TILDE
&kp TAB    &kp Q  &kp W  &kp E         &kp R           &kp T                              &kp Y         &kp U             &kp I             &kp O   &kp P    &kp MINUS
&kp LSHFT  &kp A  &kp S  &kp D         &kp F           &kp G                              &kp H         &kp J             &kp K             &kp L   &kp SEMI &kp SQT
&kp LCTRL  &mt LCTRL Z  &kp X  &kp C  &kp V           &kp B  &kp MINUS     &kp EQUAL     &kp N         &kp M             &kp COMMA         &kp DOT &kp FSLH &kp RSHFT
                          &tlt FUN ESC  &tlt NAV SPACE  &tlt NUM TAB   &kp MINUS  &kp EQUAL      &tlt SYM RET  &tlt MOUSE BSPC   &tlt MEDIA LSHFT
            
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            display-name = "Nav";
// ┌─────┬─────┬─────┬─────┬─────┬─────┐               ┌─────┬─────┬─────┬─────┬─────┬─────┐
// │     │     │     │     │     │     │               │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │ SWP │S-TAB│ RET │LSHFT│BSPC │               │C(←) │ C-D │ C-U │C(→) │ DEL │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │ GUI │ ALT │CTRL │LSHFT│CAPW │               │  ←  │  ↓  │  ↑  │  →  │C(DEL)│    │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐   ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │C(Z) │C(X) │C(C) │C(V) │     │none │   │none │HOME │PgDn │PgUp │ END │C(BS)│     │
// └─────┴─────┴─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────┴─────┘
//                   │     │▓▓▓▓▓│     │none │   │none │     │     │     │
//                   └─────┴─────┴─────┴─────┘   └─────┴─────┴─────┴─────┘
            bindings = <
&none &none     &none       &none     &none     &none                   &none       &none     &none     &none        &none       &none
&none &swapper   &kp LS(TAB)  &kp RET    &kp LSHFT  &kp BSPC                 &kp LC(LEFT) &kp LC(D)  &kp LC(U)  &kp LC(RIGHT) &kp DEL      &none
&none &skn LGUI   &skn LALT     &skn LCTRL  &skq LSHFT &caps_word               &kp LEFT     &kp DOWN   &kp UP     &kp RIGHT     &kp LC(DEL)  &none
&none &kp LC(Z)  &kp LC(X)    &kp LC(C)  &kp LC(V)  &trans &none    &none    &kp HOME     &kp PG_DN  &kp PG_UP  &kp END       &kp LC(BSPC) &none
                               &none     &trans     &trans &none    &none    &trans       &trans     &none
            
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        num_layer {
            display-name = "Num";
// ┌─────┬─────┬─────┬─────┬─────┬─────┐               ┌─────┬─────┬─────┬─────┬─────┬─────┐
// │     │     │     │     │     │     │               │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │     │     │     │     │               │     │  7  │  8  │  9  │  -  │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │ GUI │ ALT │CTRL │LSHFT│BSPC │               │     │  4  │  5  │  6  │  +  │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐   ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │  .  │  /  │  *  │  =  │     │none │   │none │     │  1  │  2  │  3  │     │     │
// └─────┴─────┴─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────┴─────┘
//                   │     │     │▓▓▓▓▓│none │   │none │     │  0  │     │
//                   └─────┴─────┴─────┴─────┘   └─────┴─────┴─────┴─────┘
            bindings = <
&none &none   &none    &none       &none    &none                   &none &none &none &none &none    &none
&none &trans   &trans    &trans       &trans    &trans                   &trans &kp N7 &kp N8 &kp N9 &kp MINUS &none
&none &skn LGUI  &skn LALT  &skn LCTRL   &skq LSHFT &kp BSPC              &trans &kp N4 &kp N5 &kp N6 &kp PLUS  &none
&none &kp DOT  &kp FSLH  &kp ASTRK   &kp EQUAL &trans &none    &none   &trans &kp N1 &kp N2 &kp N3 &trans    &none
                          &none       &trans    &trans &none    &none   &trans &kp N0 &none
            
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            display-name = "Sym";
// ┌─────┬─────┬─────┬─────┬─────┬─────┐               ┌─────┬─────┬─────┬─────┬─────┬─────┐
// │     │     │     │     │     │     │               │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │  !  │  @  │  #  │  $  │  %  │               │  ^  │  &  │  *  │  =  │  '  │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │  (  │  {  │  [  │  <  │  _  │               │  |  │LSHFT│CTRL │ ALT │ GUI │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐   ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │  )  │  }  │  ]  │  >  │  `  │none │   │none │  \  │  ~  │  :  │  "  │  ?  │     │
// └─────┴─────┴─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────┴─────┘
//                   │     │     │     │none │   │none │▓▓▓▓▓│     │     │
//                   └─────┴─────┴─────┴─────┘   └─────┴─────┴─────┴─────┘
            bindings = <
&none &none    &none   &none   &none &none                    &none    &none      &none     &none      &none   &none
&none &kp EXCL  &kp AT   &kp HASH &kp DLLR &kp PRCNT             &kp CARET &kp AMPS    &kp ASTRK  &kp EQUAL   &kp SQT  &none
&none &kp LPAR  &kp LBRC &kp LBKT &kp LT   &kp UNDER             &kp PIPE  &skq LSHFT  &skn RCTRL  &skn RALT    &skn RGUI  &none
&none &kp RPAR  &kp RBRC &kp RBKT &kp GT   &kp GRAVE &none &none &kp BSLH  &kp TILDE   &kp COLON  &kp DQT     &kp QMARK &none
                          &none   &trans   &trans    &none &none &trans &trans      &none
            
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fun_layer {
            display-name = "Fun";
// ┌─────┬─────┬─────┬─────┬─────┬─────┐               ┌─────┬─────┬─────┬─────┬─────┬─────┐
// │     │     │     │     │     │     │               │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │CANCL│     │     │     │     │               │     │ F7  │ F8  │ F9  │ F12 │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │ GUI │ ALT │CTRL │LSHFT│     │               │     │ F4  │ F5  │ F6  │ F11 │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐   ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │ BT0 │ BT1 │ BT2 │ BT3 │BTCLR│none │   │none │     │ F1  │ F2  │ F3  │ F10 │     │
// └─────┴─────┴─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────┴─────┘
//                   │▓▓▓▓▓│     │     │none │   │none │     │     │     │
//                   └─────┴─────┴─────┴─────┘   └─────┴─────┴─────┴─────┘
            bindings = <
&none &none       &none       &none       &none       &none                       &none &none &none &none &none  &none
&none &kp K_CANCEL &trans       &trans       &trans       &trans                       &trans &kp F7 &kp F8 &kp F9 &kp F12 &none
&none &skn LGUI     &skn LALT     &skn LCTRL    &skq LSHFT   &trans                      &trans &kp F4 &kp F5 &kp F6 &kp F11 &none
&none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR &none    &none  &trans &kp F1 &kp F2 &kp F3 &kp F10 &none
                                 &none       &trans       &trans     &none    &none   &trans &trans &none
            
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mouse_layer {
            display-name = "Mouse";
// ┌─────┬─────┬─────┬─────┬─────┬─────┐               ┌─────┬─────┬─────┬─────┬─────┬─────┐
// │     │     │     │     │     │     │               │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │UNDO │REDO │VD_L │VD_R │     │               │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │ ML  │ MU  │ MD  │ MR  │               │     │LSHFT│CTRL │ ALT │ GUI │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐   ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │WH_L │WH_U │WH_D │WH_R │none │   │none │SNIPE│TURBO│     │     │     │     │
// └─────┴─────┴─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────┴─────┘
//                   │RCLK │MCLK │LCLK │none │   │none │     │▓▓▓▓▓│     │
//                   └─────┴─────┴─────┴─────┘   └─────┴─────┴─────┴─────┘
            bindings = <
&none &none     &none     &none           &none            &none                         &none &none     &none     &none    &none    &none
&none &kp LC(Z)  &kp LC(Y)  &kp LC(LG(LEFT)) &kp LC(LG(RIGHT)) &trans                         &trans &trans     &trans     &trans    &trans    &none
&none &trans  &mmv MOVE_LEFT &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                &trans &skq LSHFT &skn RCTRL  &skn RALT  &skn RGUI  &none
&none &trans  &msc SCRL_LEFT &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT &none   &none  &mo M_SNIPE &mo M_TURBO &trans    &trans    &trans    &none
                                    &mkp MCLK         &mkp RCLK         &mkp LCLK       &none   &none  &trans &trans     &none
            
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        media_layer {
            display-name = "Media";
// ┌─────┬─────┬─────┬─────┬─────┬─────┐               ┌─────┬─────┬─────┬─────┬─────┬─────┐
// │     │     │     │     │     │     │               │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │     │     │     │     │               │     │     │     │     │     │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │PREV │VOL_D│VOL_U│NEXT │               │     │LSHFT│CTRL │ ALT │ GUI │     │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐   ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │     │     │MUTE │BRI_D│BRI_U│PLAY │none │   │none │     │     │     │     │     │     │
// └─────┴─────┴─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────┴─────┘
//                   │     │     │     │none │   │none │     │     │▓▓▓▓▓│
//                   └─────┴─────┴─────┴─────┘   └─────┴─────┴─────┴─────┘
            bindings = <
&none &none &none      &none      &none      &none                    &none &none     &none     &none    &none    &none
&none &trans &trans      &trans      &trans      &trans                    &trans &trans     &trans     &trans    &trans    &none
&none &trans &kp C_PREV  &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT            &trans &skq LSHFT &skn RCTRL  &skn RALT  &skn RGUI  &none
&none &trans &kp C_MUTE  &kp C_BRI_DN &kp C_BRI_UP &kp C_PP &none &none  &trans &trans     &trans     &trans    &trans    &none
                          &none      &trans      &trans    &none   &none  &trans &trans     &none
            
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };



        m_snipe_layer {
            display-name = "Snipe";
// 影子层：覆写 Mouse 层的移动键为 1/4 速度，其余键透传
            bindings = <
&none &none &none          &none         &none         &none                            &none &none &none &none &none &none
&none &trans &trans          &trans         &trans         &trans                            &trans &trans &trans &trans &trans &none
&none &trans &mmv SNIPE_L    &mmv SNIPE_U   &mmv SNIPE_D   &mmv SNIPE_R                      &trans &trans &trans &trans &trans &none
&none &trans &trans          &trans         &trans         &trans &trans &trans               &trans &trans &trans &trans &trans &none
                              &none         &trans         &trans &trans &trans               &trans &trans &none
            
            >;
        };

        m_turbo_layer {
            display-name = "Turbo";
// 影子层：覆写 Mouse 层的移动键为 2x 速度，其余键透传
            bindings = <
&none &none &none          &none         &none         &none                            &none &none &none &none &none &none
&none &trans &trans          &trans         &trans         &trans                            &trans &trans &trans &trans &trans &none
&none &trans &mmv TURBO_L    &mmv TURBO_U   &mmv TURBO_D   &mmv TURBO_R                      &trans &trans &trans &trans &trans &none
&none &trans &trans          &trans         &trans         &trans &trans &trans               &trans &trans &trans &trans &trans &none
                              &none         &trans         &trans &trans &trans               &trans &trans &none
            
            >;
        };
    };
};
